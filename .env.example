# Optional: override WebSocket server URL when hosting the frontend separately (e.g. inside infinitystudio.store)
# Leave unset when deployed together via Cloudflare Workers (`npm run deploy`).
# VITE_WS_URL=wss://ludo.infinitystudio.store

# Optional: override the base URL used in "Copy Invite Link" (`?room=...`)
# Useful when embedding the game inside https://infinitystudio.store/ludo
# VITE_PUBLIC_APP_URL=https://infinitystudio.store/ludo

# Cloudflare Worker payment and auth secrets (configure via `wrangler secret put <NAME>`):
# AUTH_SECRET=your-random-hmac-secret-hex-or-base64
# RAZORPAY_KEY_ID=rzp_live_...
# RAZORPAY_KEY_SECRET=...
# RAZORPAY_WEBHOOK_SECRET=...
